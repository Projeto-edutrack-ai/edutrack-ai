# Copie para .env. Nunca envie credenciais ao GitHub ou ao chat.
# run_server.py carrega este arquivo antes de importar a aplicação.

# Sem URL Xano: modo local com SQLite e dados de demonstração.
XANO_CRUD_BASE_URL=
# URL conferida no OpenAPI: https://x8ki-letl-twmt.n7.xano.io/api:d_CNfVCs
# Antes de ativar: proteja TODOS os endpoints no Xano conforme COMO_FINALIZAR_A_CONFIGURACAO.md.
XANO_CRUD_AUTH_HEADER=Authorization
XANO_CRUD_AUTH_VALUE=
XANO_TIMEOUT_SECONDS=15

# Identidade local e links de recuperação de senha.
# SECRET_KEY=GERE_UM_SEGREDO_ESTAVEL_PARA_PUBLICACAO
# DATABASE_URL=sqlite:///./edutrack.db
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Recuperação de senha: console só grava .eml em outbox, não entrega e-mail.
EMAIL_BACKEND=console
# Para envio real: EMAIL_BACKEND=smtp e configuração do provedor abaixo.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=EduTrack AI <SEU_REMETENTE>
PASSWORD_RESET_TOKEN_MINUTES=30

# Mentor opcional. Sem chave usa análise heurística local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opcional: permitir que o Xano chame Python para busca/PDF, com chave distinta.
XANO_PYTHON_BRIDGE_KEY=
